      {
        "params_type": "LLMRubricReviewParams",
        "check_name": "llm_rubric_review",
        "task_id": "devops-implementation-rubric",
        "params": {
          "task": {
            "id": "devops-implementation-rubric",
            "phase_id": 5,
            "requirement_slug": "devops-implementation",
            "name": "DevOps Implementation Review",
            "criteria": [
              {
                "id": "container-image",
                "label": "Application container",
                "instruction": "The Dockerfile uses an appropriate Python base image, installs dependencies reproducibly with uv, copies the app, exposes port 8000, and starts the API with uvicorn.",
                "kind": "required"
              },
              {
                "id": "delivery-workflow",
                "label": "CI/CD workflow",
                "instruction": "CI/CD runs tests, builds and pushes the image, and deploys the Kubernetes manifests from main or an equivalent protected flow.",
                "kind": "required"
              },
              {
                "id": "cloud-infrastructure",
                "label": "Cloud infrastructure",
                "instruction": "Terraform provisions a container registry, managed Kubernetes, managed PostgreSQL, and the role needed to pull images.",
                "kind": "required"
              },
              {
                "id": "kubernetes-runtime",
                "label": "Kubernetes runtime",
                "instruction": "Kubernetes defines a Deployment and Service, injects secrets without real committed credentials, and configures health probes and port 8000 routing.",
                "kind": "required"
              },
              {
                "id": "delivery-coherence",
                "label": "End-to-end coherence",
                "instruction": "CI builds the image Kubernetes deploys, Terraform provisions referenced services, and container, probe, and Service ports agree.",
                "kind": "required"
              },
              {
                "id": "deployable-configuration",
                "label": "Deployable and safe configuration",
                "instruction": "The files contain no hardcoded credentials, placeholder-only resources, contradictions, or configurations that cannot plausibly deploy the Journal API.",
                "kind": "required"
              }
            ],
            "grading_instructions": [
              "Review the Dockerfile, CI/CD workflows, Terraform, and Kubernetes manifests together as one production delivery system.",
              "Treat the required-files and public-GHCR checks as trusted passing gates; do not re-grade whether files or the image exist.",
              "Accept equivalent valid cloud-provider syntax and file organization within the published source roots. They contain the submitted deployment, not unrelated examples or alternative deployments. Do not infer an active provider folder.",
              "Only direct .yml/.yaml workflows, recursive infra/ .tf/.tf.json sources (excluding .terraform/), and recursive k8s/ .yaml/.yml sources are discovered. External modules, scripts and generated artifacts are not fetched or executed; do not invent their behavior.",
              ".dockerignore and k8s/secrets.yaml.example are optional evidence, not additional required work."
            ],
            "evidence": {
              "source": "repo_files",
              "path_patterns": [
                "Dockerfile",
                ".dockerignore",
                "k8s/deployment.yaml",
                "k8s/service.yaml",
                "k8s/secrets.yaml.example",
                ".github/workflows/",
                "infra/",
                "k8s/"
              ],
              "required_files": [
                "Dockerfile",
                "k8s/deployment.yaml",
                "k8s/service.yaml"
              ],
              "optional_files": [
                ".dockerignore",
                "k8s/secrets.yaml.example"
              ],
              "directory_rules": [
                {
                  "root": ".github/workflows/",
                  "suffixes": [
                    ".yml",
                    ".yaml"
                  ],
                  "recursive": false,
                  "required": true,
                  "excluded_directories": []
                },
                {
                  "root": "infra/",
                  "suffixes": [
                    ".tf",
                    ".tf.json"
                  ],
                  "recursive": true,
                  "required": true,
                  "excluded_directories": [
                    ".terraform"
                  ]
                },
                {
                  "root": "k8s/",
                  "suffixes": [
                    ".yaml",
                    ".yml"
                  ],
                  "recursive": true,
                  "required": false,
                  "excluded_directories": []
                }
              ],
              "criterion_evidence": {
                "container-image": [
                  "Dockerfile",
                  ".dockerignore"
                ],
                "delivery-workflow": [
                  ".github/workflows/"
                ],
                "cloud-infrastructure": [
                  "infra/"
                ],
                "kubernetes-runtime": [
                  "k8s/",
                  "k8s/secrets.yaml.example"
                ],
                "delivery-coherence": [
                  "Dockerfile",
                  ".dockerignore",
                  "k8s/deployment.yaml",
                  "k8s/service.yaml",
                  "k8s/secrets.yaml.example",
                  ".github/workflows/",
                  "infra/",
                  "k8s/"
                ],
                "deployable-configuration": [
                  "Dockerfile",
                  ".dockerignore",
                  "k8s/deployment.yaml",
                  "k8s/service.yaml",
                  "k8s/secrets.yaml.example",
                  ".github/workflows/",
                  "infra/",
                  "k8s/"
                ]
              },
              "max_files": 24,
              "max_file_size_bytes": 51200,
              "max_total_bytes": 204800,
              "redact_patterns": []
            },
            "grader": {
              "kind": "llm_rubric",
              "rubric_id": "phase5-devops-implementation-v2",
              "prompt_version": "2026-09-06",
              "passing_score": 0.8,
              "model": "gpt-5-mini"
            }
          },
          "evidence_paths": [],
          "discover_paths": true
        }
      }
    ],
